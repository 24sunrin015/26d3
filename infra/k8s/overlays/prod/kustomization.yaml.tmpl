# 이 파일은 템플릿이다. make k8s가 terraform output을 envsubst로 채워
# kustomization.yaml(gitignore)을 생성한 뒤 kubectl apply -k 한다.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: default

resources:
  - ../../base
  - hedger-resource.yaml
  - extra-apps.yaml
  - targetgroupbindings.yaml
  - hedger-targetgroupbinding.yaml

images:
  - name: user-app
    newName: ${ECR_USER}
    newTag: latest
  - name: product-app
    newName: ${ECR_PRODUCT}
    newTag: latest
  - name: stress-app
    newName: ${ECR_STRESS}
    newTag: latest
  - name: hedger-app
    newName: ${ECR_HEDGER}
    newTag: latest

configMapGenerator:
  - name: app-config
    envs:
      - config.env

secretGenerator:
  - name: app-secret
    envs:
      - secret.env

generatorOptions:
  disableNameSuffixHash: true # envFrom가 고정 이름(app-config/app-secret) 참조

patches:
  - path: sa-patch.yaml
