#!/usr/bin/env python3
"""Ghidra Go pseudocode를 사람이 읽기 쉽게 다듬는다.

Go 컴파일러는 문자열 리터럴 비교를 정수 청크 비교로 쪼갠다.

  if (((s.len == 10) && (*(int*)s.str == 0x617474612d746f62)) &&
      ((short)*(int*)((int)s.str + 8) == 0x6b63)) { ... }

여기서 hex 상수를 리틀엔디안 ASCII로 되돌리면:
  0x617474612d746f62 -> "bot-atta"  (offset 0)
  0x6b63             -> "ck"        (offset 8)
두 청크를 offset 순으로 이어붙이면 원래 검사하던 문자열 "bot-attack"이 드러난다.
len 검사값(10)과 복원 길이가 맞으면 거의 확실하다.

세 가지를 뽑는다.
  - <이름>.annotated.c : 원본 + 복원 주석
  - <이름>.readable.c  : hex를 문자열로 직접 치환 + 복원 주석
  - <이름>.py          : C 문법을 파이썬처럼 다듬은 읽기 보조본(완전한 변환 아님)

usage: prettify <pseudocode.c> [-o OUTDIR]
  OUTDIR 생략 시 ./prettified/<이름>-<YYYYMMDD-HHMMSS>.{c,py}
"""
from __future__ import annotations

import argparse
import re
import sys
from datetime import datetime
from pathlib import Path


# ── 라인 단위 hex 복원 ────────────────────────────────────────────────

HEX_RE = re.compile(r"\b0x([0-9a-fA-F]{3,16})\b")


def hex_to_bytes(hexdigits: str) -> bytes:
    """hex 리터럴을 리틀엔디안 바이트로. 자릿수로 폭을 정한다(2자리=1바이트)."""
    nbytes = (len(hexdigits) + 1) // 2
    return int(hexdigits, 16).to_bytes(nbytes, "little")


def as_ascii(raw: bytes, strip_trailing_null: bool = True) -> str | None:
    if strip_trailing_null:
        raw = raw.rstrip(b"\x00")
    if not raw:
        return None
    text = raw.decode("latin1")
    if all(32 <= ord(ch) < 127 for ch in text):
        return text
    return None


def decode_hex_literal(hexdigits: str) -> str | None:
    return as_ascii(hex_to_bytes(hexdigits))


def recovered_strings(line: str) -> list[str]:
    found: list[str] = []
    for m in HEX_RE.finditer(line):
        text = decode_hex_literal(m.group(1))
        if text is not None:
            found.append(text)
    return found


def annotate_line(line: str) -> str:
    parts = recovered_strings(line)
    if not parts:
        return line
    if len(parts) > 1:
        hint = '  // ' + " + ".join(f'"{p}"' for p in parts)
    else:
        hint = f'  // "{parts[0]}"'
    return line.rstrip("\n") + hint


def substitute_line(line: str) -> str:
    def repl(m: re.Match) -> str:
        text = decode_hex_literal(m.group(1))
        return f'"{text}"' if text is not None else m.group(0)

    return HEX_RE.sub(repl, line)


# ── 블록 단위 문자열 비교 복원 ────────────────────────────────────────

# 같은 문자열 변수의 청크 비교. 예:
#   *(int *)sVar9.str == 0x617474612d746f62
#   (short)*(int *)((int)sVar9.str + 8) == 0x6b63
CHUNK_RE = re.compile(
    r"(?P<var>[A-Za-z_]\w*)\.str\s*(?:\+\s*(?P<off>\d+)\s*)?\)*\s*==\s*0x(?P<hex>[0-9a-fA-F]+)"
)
# 길이 검사. 예: sVar9.len == 10  /  sVar13.len == 0xc
LEN_RE = re.compile(r"(?P<var>[A-Za-z_]\w*)\.len\s*==\s*(?P<n>0x[0-9a-fA-F]+|\d+)")


def find_if_conditions(lines: list[str]) -> list[tuple[int, int, str]]:
    """`if (` 조건을 괄호 균형으로 추출. (start_idx, end_idx, condition_text) 목록."""
    blocks: list[tuple[int, int, str]] = []
    i = 0
    n = len(lines)
    while i < n:
        m = re.search(r"\bif\s*\(", lines[i])
        if not m:
            i += 1
            continue
        depth = 0
        started = False
        parts: list[str] = []
        j = i
        pos = m.end() - 1  # '(' 위치
        while j < n:
            segment = lines[j][pos:] if j == i else lines[j]
            for ch in segment:
                if ch == "(":
                    depth += 1
                    started = True
                elif ch == ")":
                    depth -= 1
                parts.append(ch)
                if started and depth == 0:
                    break
            if started and depth == 0:
                break
            j += 1
        else:
            break
        blocks.append((i, j, "".join(parts)))
        i = j + 1
    return blocks


def restore_from_condition(cond: str) -> list[tuple[str, str, int | None]]:
    """조건 텍스트에서 변수별 문자열을 복원.

    반환: (var, restored_string, declared_len) 목록.
    """
    # 변수별 (offset, bytes) 수집
    chunks: dict[str, dict[int, bytes]] = {}
    for m in CHUNK_RE.finditer(cond):
        var = m.group("var")
        off = int(m.group("off")) if m.group("off") else 0
        raw = hex_to_bytes(m.group("hex"))
        chunks.setdefault(var, {})[off] = raw

    declared: dict[str, int] = {}
    for m in LEN_RE.finditer(cond):
        declared[m.group("var")] = int(m.group("n"), 16 if m.group("n").startswith("0x") else 10)

    results: list[tuple[str, str, int | None]] = []
    for var, byoff in chunks.items():
        total = max(off + len(b) for off, b in byoff.items())
        buf = bytearray(total)
        for off, b in byoff.items():
            buf[off:off + len(b)] = b
        text = as_ascii(bytes(buf))
        if text is None:
            continue
        # 단일 청크 + 짧은 값은 라인 주석이 이미 처리하므로 블록 요약에서 제외
        if len(byoff) < 2 and var not in declared:
            continue
        results.append((var, text, declared.get(var)))
    return results


def build_block_summaries(lines: list[str]) -> dict[int, list[str]]:
    """if 블록 시작 줄 앞에 삽입할 요약 주석 매핑. {start_idx: [comment, ...]}"""
    summaries: dict[int, list[str]] = {}
    for start, _end, cond in find_if_conditions(lines):
        restored = restore_from_condition(cond)
        for var, text, dlen in restored:
            indent = re.match(r"\s*", lines[start]).group(0)
            match = "" if dlen is None or dlen == len(text) else "  (※ len 불일치)"
            summaries.setdefault(start, []).append(
                f'{indent}// [복원] {var} == "{text}"{match}'
            )
    return summaries


# ── C 유사 pseudocode → 파이썬 유사 코드 ──────────────────────────────

# 타입 캐스트 제거용. (int *), (short), (undefined8), (sdword) 등.
CAST_RE = re.compile(
    r"\(\s*(?:unsigned\s+|signed\s+)?"
    r"(?:u?char|s?byte|u?short|s?word|u?int|s?dword|u?long|s?qword|"
    r"undefined[1248]?|code|void|bool)\s*\**\s*\)"
)

CTRL_RE = re.compile(r"^\s*(if|else if|while|for|switch|do)\b")

LABEL_DEF_RE = re.compile(r"\bLAB_([0-9a-fA-F]+)\s*:")
LABEL_REF_RE = re.compile(r"\bLAB_([0-9a-fA-F]+)\b")


def simplify_labels(text: str) -> str:
    """긴 LAB_<주소>를 label_N으로 줄이고, goto에 점프 방향(위/아래)을 주석으로 단다.

    Ghidra는 라벨을 `LAB_0078be68:` 주소 그대로 남긴다. 짧은 이름이 읽기 쉽다.
    goto가 자기보다 위 라벨로 가면 반복(loop), 아래면 건너뛰기(skip)다.
    """
    lines = text.splitlines()

    # 등장 순서대로 주소 → label_N 매핑
    order: list[str] = []
    for line in lines:
        for m in LABEL_REF_RE.finditer(line):
            if m.group(1) not in order:
                order.append(m.group(1))
    if not order:
        return text
    names = {addr: f"label_{i + 1}" for i, addr in enumerate(order)}

    # 각 라벨 정의가 몇 번째 줄인지
    def_line: dict[str, int] = {}
    for idx, line in enumerate(lines):
        m = LABEL_DEF_RE.search(line)
        if m:
            def_line[m.group(1)] = idx

    out: list[str] = []
    for idx, line in enumerate(lines):
        new = LABEL_REF_RE.sub(lambda m: names[m.group(1)], line)
        gm = re.search(r"goto\s+(label_\d+)", new)
        if gm and "#" not in new:
            addr = order[int(gm.group(1).split("_")[1]) - 1]
            tgt = def_line.get(addr)
            if tgt is not None:
                new += "  # 위로 반복" if tgt < idx else "  # 아래로 건너뜀"
        out.append(new)
    return "\n".join(out) + "\n"


def c_expr_to_python(expr: str) -> str:
    """한 줄의 C 식을 파이썬 문법에 가깝게 다듬는다(완전한 변환 아님)."""
    code, sep, comment = expr.partition("//")
    code = CAST_RE.sub("", code)
    code = code.replace("&&", " and ").replace("||", " or ")
    code = code.replace("->", ".")
    code = code.replace("::", ".")
    code = re.sub(r"\btrue\b", "True", code)
    code = re.sub(r"\bfalse\b", "False", code)
    code = re.sub(r"\bNULL\b", "None", code)
    code = re.sub(r"\s+", " ", code).strip()
    if sep:
        code = f"{code}  # {comment.strip()}" if code else f"# {comment.strip()}"
    return code


def to_python(text: str) -> str:
    """중괄호 깊이로 인덴트를 재구성한 파이썬 유사 코드."""
    lines = text.splitlines()
    summaries = build_block_summaries(lines)
    out = [
        "# ⚠ Ghidra pseudocode를 기계적으로 파이썬 문법에 맞춰 다듬은 읽기 보조본입니다.",
        "# 실행되는 코드가 아니라 흐름 파악용입니다. 정확한 로직은 .readable.c 를 보세요.",
        "",
    ]
    depth = 0
    for idx, raw in enumerate(lines):
        for comment in summaries.get(idx, []):
            out.append("    " * depth + comment.strip().replace("//", "#", 1))

        line = substitute_line(raw).strip()
        if not line:
            out.append("")
            continue

        opens = line.count("{")
        closes = line.count("}")
        net = opens - closes
        body = line.replace("{", "").replace("}", "").rstrip(";").strip()

        # 순수 괄호 줄({, }, };)은 인덴트로만 반영하고 버린다
        if body == "":
            depth = max(0, depth + net)
            continue

        py = c_expr_to_python(body)
        is_header = bool(CTRL_RE.match(body)) or (opens > closes)
        if is_header and py and not py.endswith(":"):
            py += ":"

        if net < 0:  # 닫기가 앞선 줄이면 먼저 내어쓴다
            depth = max(0, depth + net)
        out.append("    " * depth + py)
        if net > 0:
            depth += net

    return "\n".join(out) + "\n"


# ── 조립 ──────────────────────────────────────────────────────────────

def prettify_c(text: str, inline: bool) -> str:
    lines = text.splitlines()
    summaries = build_block_summaries(lines)
    out: list[str] = []
    for idx, line in enumerate(lines):
        for comment in summaries.get(idx, []):
            out.append(comment)
        out.append(substitute_line(line) if inline else annotate_line(line))
    return "\n".join(out) + "\n"


def main() -> int:
    ap = argparse.ArgumentParser(description="Ghidra Go pseudocode 문자열 복원기")
    ap.add_argument("input", type=Path, help="pseudocode .c 파일")
    ap.add_argument(
        "-o", "--outdir", type=Path,
        help="출력 디렉토리(기본: ./prettified)",
    )
    args = ap.parse_args()

    if not args.input.is_file():
        print(f"파일 없음: {args.input}", file=sys.stderr)
        return 2

    # 입력 가드: 바이너리를 넣으면 쓰레기가 나온다. 텍스트 pseudocode만 받는다.
    head = args.input.read_bytes()[:4096]
    if head[:4] == b"\x7fELF":
        print(
            f"입력이 ELF 바이너리입니다: {args.input}\n"
            "이 툴은 Ghidra가 뽑은 pseudocode(.c)를 다듬습니다. "
            "먼저 disassembly로 pseudocode를 추출한 뒤 그 .c 파일을 넣으세요.\n"
            "  cd ../disassembly && ./disasm <바이너리>\n"
            "  ./prettify ../disassembly/disassembly/<...>/pseudocode/<함수>.c",
            file=sys.stderr,
        )
        return 2
    if b"\x00" in head:
        print(
            f"입력이 텍스트가 아닙니다(NUL 바이트 발견): {args.input}\n"
            "Ghidra pseudocode(.c) 텍스트 파일을 넣으세요.",
            file=sys.stderr,
        )
        return 2

    source = args.input.read_text(errors="replace")
    outdir = args.outdir or Path("prettified")
    outdir.mkdir(parents=True, exist_ok=True)

    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    base = f"{args.input.stem}-{ts}"

    annotated_path = outdir / f"{base}.annotated.c"
    readable_path = outdir / f"{base}.readable.c"
    python_path = outdir / f"{base}.py"
    annotated_path.write_text(prettify_c(source, inline=False))
    readable_path.write_text(prettify_c(source, inline=True))
    python_path.write_text(simplify_labels(to_python(source)))

    # 복원된 문자열 요약 출력
    restored_all: list[str] = []
    for _s, _e, cond in find_if_conditions(source.splitlines()):
        for var, txt, _dlen in restore_from_condition(cond):
            restored_all.append(f'  {var} == "{txt}"')

    print(f"주석본  : {annotated_path}")
    print(f"치환본  : {readable_path}")
    print(f"파이썬  : {python_path}")
    if restored_all:
        print("복원된 문자열 비교:")
        for r in restored_all:
            print(r)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
